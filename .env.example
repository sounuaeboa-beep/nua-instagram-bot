# Same names as the GitHub repo secrets (Settings > Secrets and variables > Actions)
ANTHROPIC_API_KEY=            # console.anthropic.com
IG_ACCESS_TOKEN=              # long-lived token from the Instagram Login OAuth flow (refreshed automatically each run)
IG_USER_ID=                   # "user_id" returned by that OAuth flow
CLOUDINARY_CLOUD_NAME=        # cloudinary.com free plan: Dashboard > API Keys
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REPO_ADMIN_TOKEN=             # fine-grained GitHub token, this repo only, "Secrets: read and write" (saves the refreshed IG token)
