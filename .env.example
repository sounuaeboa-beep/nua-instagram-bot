# Anthropic (Claude API) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Canva Connect API — https://www.canva.dev/docs/connect/
# Access tokens expire every 4h and refresh tokens rotate on every use,
# so the pipeline refreshes automatically each run and needs a GitHub PAT
# (REPO_ADMIN_TOKEN, secrets:write scope) to persist the new refresh token.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REFRESH_TOKEN=
CANVA_BRAND_TEMPLATE_ID=
REPO_ADMIN_TOKEN=

# Shopify Admin API — Settings > Apps > Develop apps > (your app) > API credentials
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Instagram Graph API (Instagram Login / Business Login for Instagram flow)
IG_ACCESS_TOKEN=
IG_USER_ID=
